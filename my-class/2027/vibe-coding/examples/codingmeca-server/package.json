{
  "name": "codingmeca-server",
  "version": "1.0.0",
  "private": true,
  "description": "코딩메카 서버: 대전 계산(권한은 서버), 융합·변신, 리그·토너먼트, 리플레이. 비공개 저장소 전용.",
  "type": "module",
  "main": "index.js",
  "engines": { "node": ">=20" },
  "imports": {
    "#shared/*": "./shared/*",
    "#config/*": "./config/*",
    "#data/*": "./data/*"
  },
  "scripts": {
