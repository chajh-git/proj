    "build": "npm run sync",
    "start": "node index.js",
    "dev": "DEV_AUTH=1 DEV_MEMORY_DB=1 node index.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "ws": "^8.18.0"
  }
}
