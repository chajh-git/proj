<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>사운드웍스 - 스피커 제작 시뮬레이터</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light dark;
  --panel:#f1f4f3; --panel2:#e3e9e8; --ink:#14232b; --ink2:#52646c; --line:#c5d0d0;
  --accent:#b85a08; --accent2:#e59a2e; --on-accent:#fffaf0; --good:#1d7a4f; --bad:#b3392d; --warn:#946200;
  --scrim:rgba(8,14,18,.62); --hud:rgba(20,35,43,.82); --hud-ink:#f2efe6;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --panel:#1b2830; --panel2:#243540; --ink:#eaf0ee; --ink2:#9db0b5; --line:#33474f;
    --accent:#f2ae3d; --accent2:#ffd27a; --on-accent:#1a1205; --good:#56c596; --bad:#f08577; --warn:#e8b64f;
    --scrim:rgba(4,8,10,.7); --hud:rgba(10,18,22,.8); --hud-ink:#f2efe6;
  }
}
:root[data-theme="dark"]{
  --panel:#1b2830; --panel2:#243540; --ink:#eaf0ee; --ink2:#9db0b5; --line:#33474f;
  --accent:#f2ae3d; --accent2:#ffd27a; --on-accent:#1a1205; --good:#56c596; --bad:#f08577; --warn:#e8b64f;
  --scrim:rgba(4,8,10,.7); --hud:rgba(10,18,22,.8); --hud-ink:#f2efe6;
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;height:100%;background:#0c1114;overflow:hidden;font-family:'IBM Plex Sans KR',system-ui,-apple-system,'Malgun Gothic','Noto Sans KR',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;-webkit-user-select:none;user-select:none}
.mono{font-family:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}
#c{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}
#hud{position:fixed;inset:0;pointer-events:none;color:var(--hud-ink)}
#stats{position:absolute;left:calc(env(safe-area-inset-left,0px) + 14px);top:calc(env(safe-area-inset-top,0px) + 14px);display:flex;gap:8px}
.stat{background:var(--hud);border-radius:10px;padding:8px 14px;backdrop-filter:blur(6px)}
.stat .k{display:block;font-size:11px;opacity:.7;margin-bottom:1px}
.stat .v{font-size:18px;font-weight:500}
#hudBtns{position:absolute;right:calc(env(safe-area-inset-right,0px) + 14px);top:calc(env(safe-area-inset-top,0px) + 14px);display:flex;gap:8px;pointer-events:auto;flex-wrap:wrap;justify-content:flex-end;max-width:60vw}
#hudBtns button{background:var(--hud);color:var(--hud-ink);border:0;border-radius:10px;padding:9px 13px;font:inherit;font-size:13px;cursor:pointer}
#hudBtns button:hover{background:rgba(40,60,70,.9)}
#cross{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;background:rgba(255,255,255,.75);box-shadow:0 0 0 1px rgba(0,0,0,.35)}
#where{position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 14px);transform:translateX(-50%);background:var(--hud);padding:6px 14px;border-radius:999px;font-size:12px;opacity:.9;white-space:nowrap}
#prompt{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 112px);transform:translateX(-50%);background:var(--hud);padding:11px 20px;border-radius:999px;font-size:15px;font-weight:500;display:none;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis}
#prompt b{display:inline-block;background:var(--accent);color:var(--on-accent);border-radius:6px;padding:1px 9px;margin-right:9px;font-family:'IBM Plex Mono',monospace}
#toast{position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 74px);transform:translateX(-50%);background:var(--accent);color:var(--on-accent);padding:10px 18px;border-radius:10px;font-size:14px;font-weight:500;opacity:0;transition:opacity .25s;max-width:86vw;text-align:center;z-index:30}
#toast.on{opacity:1}
#speedo{position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 54px);transform:translateX(-50%);background:var(--hud);padding:7px 16px;border-radius:12px;font-size:15px;font-weight:500;white-space:nowrap}
#speedo[hidden]{display:none}
#toast.bad{background:var(--bad);color:#fff}
#fade{position:fixed;inset:0;background:#05080a;color:#cfd8d6;display:flex;align-items:center;justify-content:center;font-size:16px;opacity:0;pointer-events:none;transition:opacity .6s;z-index:40}
#fade.on{opacity:1;pointer-events:auto}
#start{position:fixed;inset:0;background:var(--scrim);display:flex;align-items:center;justify-content:center;padding:20px;z-index:20;overflow:auto}
.startcard{background:var(--panel);color:var(--ink);border-radius:16px;max-width:580px;width:100%;padding:28px 28px 24px;box-shadow:0 24px 70px rgba(0,0,0,.45)}
.credit{position:absolute;left:0;right:0;bottom:calc(env(safe-area-inset-bottom,0px) + 18px);text-align:center;color:#4da3ff;font-size:14px;font-weight:500;padding:0 16px}
.startcard h1{margin:0 0 6px;font-size:28px;letter-spacing:-.02em}
.startcard p{margin:0 0 14px;color:var(--ink2);line-height:1.6;font-size:15px}
.keys{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;margin:16px 0 18px;font-size:14px;align-items:center}
kbd{font-family:'IBM Plex Mono',monospace;background:var(--panel2);border:1px solid var(--line);border-bottom-width:2px;border-radius:6px;padding:2px 8px;font-size:12px}
.btn{background:var(--accent);color:var(--on-accent);border:0;border-radius:9px;padding:9px 16px;font:inherit;font-size:14px;font-weight:500;cursor:pointer}
.btn:hover{filter:brightness(1.08)}
.btn:disabled{opacity:.4;cursor:not-allowed;filter:none}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.ghost:hover{background:var(--panel2)}
.btn.big{padding:13px 22px;font-size:16px;width:100%}
.btn.sm{padding:6px 12px;font-size:13px}
.btn:focus-visible,select:focus-visible,input:focus-visible,.tab:focus-visible{outline:2px solid var(--accent2);outline-offset:2px}
#modal{position:fixed;inset:0;background:var(--scrim);display:flex;align-items:center;justify-content:center;padding:calc(env(safe-area-inset-top,0px) + 10px) 10px calc(env(safe-area-inset-bottom,0px) + 10px);z-index:10}
#modal[hidden],#start[hidden]{display:none}
.sheet{background:var(--panel);color:var(--ink);border-radius:16px;width:min(1080px,100%);max-height:100%;display:flex;flex-direction:column;box-shadow:0 24px 70px rgba(0,0,0,.5)}
.shead{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--line);gap:10px}
.shead h2{margin:0;font-size:19px;letter-spacing:-.01em}
.shead .sub{font-size:13px;color:var(--ink2);font-weight:400;margin-left:10px}
#sheetBody{padding:16px 20px 20px;overflow:auto;-webkit-user-select:none;user-select:none}
.tabs{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.tab{background:transparent;border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:8px 16px;font:inherit;font-size:14px;cursor:pointer}
.tab.on{background:var(--ink);color:var(--panel);border-color:var(--ink)}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.card{background:var(--panel2);border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:7px}
.gfx{background:var(--panel);border-radius:10px;display:flex;align-items:center;justify-content:center;height:124px}
.kind{font-size:12px;color:var(--accent);font-weight:700}
.ct{font-weight:700;font-size:15px}
.cs{font-size:12.5px;color:var(--ink2);line-height:1.55;font-family:'IBM Plex Mono',monospace}
.cd{font-size:13px;line-height:1.5}
.cf{display:flex;align-items:center;gap:10px;margin-top:auto;padding-top:6px}
.cf .price{font-weight:500;font-size:15px;flex:1}
.cf .own{font-size:12px;color:var(--ink2)}
.shopintro{font-size:14px;color:var(--ink2);margin:0 0 12px;line-height:1.55}
.bench{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:18px}
@media (max-width:820px){.bench{grid-template-columns:1fr}}
.stage{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:12px;background:var(--panel2);border-radius:12px;padding:14px;align-items:center}
.cabcol{display:flex;flex-direction:column;align-items:center;gap:8px;min-height:370px;justify-content:center}
.cab{position:relative;border-radius:10px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.3),0 8px 18px rgba(0,0,0,.28)}
.cab.ghost{background:transparent!important;border:2px dashed var(--line);box-shadow:none}
.baffle{position:absolute;inset:7px;border-radius:5px;background:#171b1e}
.cab.ghost .baffle{background:transparent}
.cab.target{box-shadow:0 0 0 3px rgba(242,174,61,.55)}
.cab.over{box-shadow:0 0 0 4px var(--accent2)}
.ghosttext{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:12.5px;color:var(--ink2);padding:0 14px;pointer-events:none;line-height:1.5}
.slot{position:absolute;display:flex;align-items:center;justify-content:center;border:2px dashed rgba(255,255,255,.3);box-sizing:border-box;transition:background .12s,border-color .12s}
.slot.circ{border-radius:50%;left:50%;transform:translateX(-50%)}
.slot.side{position:relative;border-radius:10px;border-color:var(--line);width:100%;min-height:124px;flex-direction:column;gap:3px;padding:8px;text-align:center;font-size:12px;color:var(--ink2);margin-bottom:10px;line-height:1.4}
.slot.filled{border-style:solid;border-color:transparent}
.slot.side.filled{border-color:var(--line);background:var(--panel)}
.slot.target{border-color:var(--accent2);box-shadow:0 0 0 3px rgba(242,174,61,.35)}
.slot.over{background:rgba(242,174,61,.3)}
.slot.locked{opacity:.4}
.slot .nm{font-size:11.5px;color:var(--ink);font-weight:500;line-height:1.3}
.placed{width:100%;height:100%;display:flex;align-items:center;justify-content:center;cursor:grab;touch-action:none;flex-direction:column}
.slot.side .placed{height:auto}
.rm{position:absolute;top:-8px;right:-8px;width:24px;height:24px;border-radius:50%;border:0;background:var(--bad);color:#fff;font-size:15px;line-height:1;cursor:pointer;z-index:2;padding:0}
.cabcap{font-size:12px;color:var(--ink2);text-align:center;min-height:16px;position:relative}
.tray{margin-top:12px}
.trayitems{display:grid;grid-template-columns:repeat(auto-fill,minmax(52px,1fr));gap:5px;min-height:60px}
.titem{background:var(--panel2);border-radius:10px;padding:8px 6px;text-align:center;cursor:grab;touch-action:none;position:relative;font-size:12px;line-height:1.35;border:2px solid transparent}
.titem.held{border-color:var(--accent)}
.titem .cnt{position:absolute;top:5px;right:6px;background:var(--ink);color:var(--panel);border-radius:999px;font-size:11px;padding:0 7px;font-family:'IBM Plex Mono',monospace}
.titem .tn{display:block;margin-top:2px}
.hint{font-size:12.5px;color:var(--ink2);margin:8px 2px 0;line-height:1.5}
.hint b{color:var(--accent)}
.ghostdrag{position:fixed;pointer-events:none;z-index:60;transform:translate(-50%,-62%);filter:drop-shadow(0 8px 14px rgba(0,0,0,.45));opacity:.96}
.res{background:var(--panel2);border-radius:12px;padding:16px 18px;margin-bottom:14px}
.rtop{display:flex;align-items:center;gap:16px;margin-bottom:12px}
.grade{width:58px;height:58px;border-radius:12px;background:var(--ink);color:var(--panel);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;font-family:'IBM Plex Mono',monospace}
.rtop .big{font-size:20px;font-weight:700}
.rtop .small{font-size:13px;color:var(--ink2)}
.metric{display:grid;grid-template-columns:86px 1fr 84px;gap:10px;align-items:center;margin:7px 0;font-size:13px}
.metric .val{text-align:right;font-family:'IBM Plex Mono',monospace;font-size:12.5px}
.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2))}
.warns{margin:12px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px}
.warns li{font-size:13px;line-height:1.5;padding:8px 11px;border-radius:8px;background:var(--panel)}
.warns li.bad{border-left:4px solid var(--bad)}
.warns li.warn{border-left:4px solid var(--warn)}
.warns li.info{border-left:4px solid var(--good)}
.note{padding:14px 16px;background:var(--panel2);border-radius:10px;font-size:14px;line-height:1.55;margin-bottom:14px}
.note.bad{border-left:4px solid var(--bad)}
.listen{background:var(--panel2);border-radius:12px;padding:14px 16px;margin-bottom:14px}
.lrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.lrow b{font-size:14px;margin-right:4px}
.lrow input[type=range]{flex:1;min-width:120px;accent-color:var(--accent)}
.lrow .lv{font-family:'IBM Plex Mono',monospace;font-size:13px;min-width:56px}
#scope{width:100%;height:150px;display:block;border-radius:8px;background:var(--panel)}
.lstat{font-size:12.5px;color:var(--ink2);margin-top:8px;line-height:1.5}
.lstat.bad{color:var(--bad);font-weight:700}
.lstat.warn{color:var(--warn);font-weight:700}
.sect{font-size:14px;font-weight:700;margin:20px 0 8px}
.stockrow{display:flex;align-items:center;gap:12px;background:var(--panel2);border-radius:10px;padding:10px 14px;margin-bottom:8px}
.stockrow .nm{flex:1;min-width:0}
.stockrow .nm b{font-size:14px}
.stockrow .nm span{display:block;font-size:12px;color:var(--ink2);margin-top:2px}
.mini{width:34px;height:34px;border-radius:8px;background:var(--ink);color:var(--panel);display:flex;align-items:center;justify-content:center;font-weight:700;font-family:'IBM Plex Mono',monospace;flex:none}
.cust{background:var(--panel2);border-radius:12px;padding:16px 18px;margin-bottom:16px;display:flex;gap:16px}
.avatar{width:54px;height:54px;border-radius:50%;flex:none}
.cust h3{margin:0 0 4px;font-size:17px}
.cust .say{font-size:14px;line-height:1.6;margin-bottom:10px}
.reqs{display:flex;flex-direction:column;gap:5px;font-size:13px}
.reqs div{display:flex;gap:8px;align-items:baseline}
.mk{font-weight:700}
.mk.ok{color:var(--good)}.mk.mid{color:var(--warn)}.mk.no{color:var(--bad)}
.help p{font-size:14px;line-height:1.7;margin:0 0 12px}
.help h4{margin:18px 0 6px;font-size:15px}
/* 터치 조작 */
#touch{position:absolute;inset:0;pointer-events:none;display:none}
body.touchui #touch{display:block}
body.modalopen #touch{display:none}
#joy{position:absolute;left:calc(env(safe-area-inset-left,0px) + 22px);bottom:calc(env(safe-area-inset-bottom,0px) + 84px);width:136px;height:136px;border-radius:50%;background:rgba(10,18,22,.42);border:2px solid rgba(255,255,255,.35);pointer-events:auto;touch-action:none}
#knob{position:absolute;left:50%;top:50%;width:58px;height:58px;margin:-29px 0 0 -29px;border-radius:50%;background:rgba(242,174,61,.88);box-shadow:0 2px 8px rgba(0,0,0,.4)}
.tbtn{position:absolute;pointer-events:auto;touch-action:none;border:2px solid rgba(255,255,255,.4);border-radius:50%;background:rgba(10,18,22,.55);color:#fff;font:inherit;font-weight:700;display:flex;align-items:center;justify-content:center;cursor:pointer}
#tAct{right:calc(env(safe-area-inset-right,0px) + 26px);bottom:calc(env(safe-area-inset-bottom,0px) + 98px);width:92px;height:92px;font-size:22px;background:rgba(242,174,61,.9);color:#1a1205;display:none}
#tThrow{right:calc(env(safe-area-inset-right,0px) + 36px);bottom:calc(env(safe-area-inset-bottom,0px) + 276px);width:62px;height:62px;font-size:12px;display:none}
#tRun{right:calc(env(safe-area-inset-right,0px) + 36px);bottom:calc(env(safe-area-inset-bottom,0px) + 208px);width:62px;height:62px;font-size:12px}
#tRun.on{background:rgba(242,174,61,.9);color:#1a1205}
@media (max-width:560px){.metric{grid-template-columns:70px 1fr 74px}.stage{grid-template-columns:minmax(0,1fr) 128px}#where{display:none}}
#confirm{position:fixed;inset:0;background:rgba(4,8,10,.55);display:flex;align-items:center;justify-content:center;padding:20px;z-index:50}
#confirm[hidden]{display:none}
.cbox{background:var(--panel);color:var(--ink);border-radius:14px;padding:22px 24px 18px;max-width:420px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.cbox p{margin:0 0 18px;font-size:16px;line-height:1.55;font-weight:500}
.crow{display:flex;gap:10px;justify-content:flex-end}
#done{position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 84px);transform:translateX(-50%);background:var(--ink);color:var(--panel);padding:7px 16px;border-radius:999px;font-size:13px;font-weight:500;opacity:0;pointer-events:none;transition:opacity .2s;z-index:55}
#done.on{opacity:1}
#goalChip{position:absolute;left:calc(env(safe-area-inset-left,0px) + 14px);top:calc(env(safe-area-inset-top,0px) + 74px);max-width:min(72vw,330px);background:var(--hud);padding:6px 12px;border-radius:10px;font-size:12.5px;line-height:1.4}
#goalChip.done{background:var(--accent);color:var(--on-accent);font-weight:700}
#inv{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 10px);transform:translateX(-50%);width:min(94vw,540px);pointer-events:auto}
#invInfo{display:none;margin:0 auto 6px;width:fit-content;max-width:100%;background:var(--hud);color:var(--hud-ink);padding:6px 12px;border-radius:10px;font-size:12.5px;line-height:1.45;text-align:center}
#invRow{display:grid;grid-template-columns:repeat(9,1fr);gap:5px;background:var(--hud);padding:6px;border-radius:12px;backdrop-filter:blur(6px)}
.slotI{aspect-ratio:1;background:rgba(255,255,255,.09);border-radius:8px;position:relative;display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;color:var(--hud-ink);font-size:12px}
.slotI svg{width:82%;height:82%}
.slotI .n{position:absolute;right:3px;bottom:1px;font-size:11px;font-weight:700;color:#fff;text-shadow:0 1px 2px #000;font-family:'IBM Plex Mono',monospace}
.slotI.hi{box-shadow:inset 0 0 0 2px #f2ae3d}
.slotI.empty{cursor:default;background:rgba(255,255,255,.04)}
.slotI.sel{box-shadow:0 0 0 3px #ff7a1a,inset 0 0 0 1px rgba(255,255,255,.35);background:rgba(255,122,26,.18)}
#goal{position:fixed;inset:0;background:rgba(4,8,10,.6);display:flex;align-items:center;justify-content:center;padding:20px;z-index:52}
#goal[hidden]{display:none}
#goal .cbox p{line-height:1.7}
#hudBtns button[hidden]{display:none}
#devName{position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 110px);transform:translateX(-50%);background:rgba(0,0,0,.75);color:#7dff7d;padding:6px 14px;border-radius:8px;font-family:'IBM Plex Mono',monospace;font-size:13px;white-space:pre-line;text-align:left;max-width:92vw}
#devName[hidden]{display:none}
.devbtn{background:transparent;color:var(--ink2);border:1px dashed var(--line);border-radius:8px;padding:8px 12px;font:inherit;font-size:13px;cursor:pointer;margin-top:12px;width:100%}
#devPw{margin-top:10px;display:flex;gap:8px}
#devPw[hidden]{display:none}
#devPw input{flex:1;padding:9px 10px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font:inherit}
#coach{position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 54px);transform:translateX(-50%);background:var(--hud);padding:8px 16px;border-radius:12px;font-size:14px;font-weight:500;line-height:1.45;text-align:center;max-width:min(88vw,520px);border:2px solid #3ddc84}
#coach[hidden]{display:none}
.coach{background:var(--panel2);border-left:4px solid #3ddc84;border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:14px;line-height:1.6}
.pulse{animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(61,220,132,.85)}70%{box-shadow:0 0 0 12px rgba(61,220,132,0)}100%{box-shadow:0 0 0 0 rgba(61,220,132,0)}}
.modes{display:flex;flex-direction:column;gap:18px;margin-top:20px}
