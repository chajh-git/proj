let drag=null;
function slotHit(p,x,y){
  const cat=p.cat;
  const els=cat==='e'?[...body.querySelectorAll('.cab')]:[...body.querySelectorAll(`.slot[data-cat="${cat}"]`)];
  for(const el of els){const r=el.getBoundingClientRect(),m=16;if(x>=r.left-m&&x<=r.right+m&&y>=r.top-m&&y<=r.bottom+m)return el;}
  return null;
}
function markTargets(on,p){
  body.querySelectorAll('.slot,.cab').forEach(el=>el.classList.remove('target','over'));
  if(!on)return;
  if(p.cat==='e')body.querySelectorAll('.cab').forEach(el=>el.classList.add('target'));
  else body.querySelectorAll(`.slot[data-cat="${p.cat}"]`).forEach(el=>el.classList.add('target'));
}
body.addEventListener('pointerdown',e=>{
  if(cur!=='bench')return;
  const it=e.target.closest('[data-drag]');
  if(!it||e.target.closest('[data-act]'))return;
  if(e.pointerType==='mouse'&&e.button!==0)return;
  e.preventDefault();
  drag={id:it.dataset.drag,from:it.dataset.from,sx:e.clientX,sy:e.clientY,moved:false,ghost:null,pid:e.pointerId};
});
window.addEventListener('pointermove',e=>{
  if(!drag||e.pointerId!==drag.pid)return;
  const p=BY[drag.id];
  if(!drag.moved&&Math.hypot(e.clientX-drag.sx,e.clientY-drag.sy)>7){
    drag.moved=true;
    const g=document.createElement('div');g.className='ghostdrag';g.innerHTML=partSVG(p,84);document.body.appendChild(g);drag.ghost=g;
    markTargets(true,p);
  }
  if(drag.moved){
    drag.ghost.style.left=e.clientX+'px';drag.ghost.style.top=e.clientY+'px';
    body.querySelectorAll('.slot,.cab').forEach(el=>el.classList.remove('over'));
    const h=slotHit(p,e.clientX,e.clientY);if(h)h.classList.add('over');
  }
});
function endDrag(e,cancel){
  if(!drag||e.pointerId!==drag.pid)return;
  const d=drag;drag=null;
  if(d.ghost)d.ghost.remove();
  markTargets(false);
  if(cancel)return;
  const p=BY[d.id];
  if(!d.moved){
    if(!d.from){held=held===d.id?null:d.id;renderBench(false);}
    return;
  }
  const h=slotHit(p,e.clientX,e.clientY);
  if(h){
    if(d.from&&sel[p.cat]===d.id)return;
    place(d.id);
  }else if(d.from){
    sel[d.from]='';if(d.from==='e'){sel.w='';sel.t='';}renderBench(true);
  }else{
    const other=document.elementFromPoint(e.clientX,e.clientY);
    const sl=other&&other.closest&&other.closest('.slot[data-cat]');
    if(sl&&sl.dataset.cat!==p.cat)toast(`${p.name}은(는) ${CATNAME[p.cat]} 자리에 놓아요.`,true);
  }
}
