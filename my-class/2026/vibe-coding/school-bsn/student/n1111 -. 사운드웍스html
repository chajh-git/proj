  }
  if(maxDev>4){
    const nearBk=w.breakup&&Math.abs(Math.log(maxF/w.breakup.f))<.5;
    warn('warn',`${fmtHz(maxF)} 부근이 ${maxDev.toFixed(1)}dB 튀어요.`+(nearBk?' 알루미늄 콘의 분할진동 피크예요. 더 가파른 24dB 크로스오버로 억제해보세요.':''));
  }else if(x.slope===12&&maxDev>2&&Math.abs(Math.log(maxF/x.f))<.5){
    warn('info','12dB 크로스오버는 경계 부근이 조금 튀어요. 24dB로 바꾸면 평탄해져요.');
  }
  const strain=x.f<tw.low*.95;
  if(strain)warn('bad',`크로스오버(${fmtHz(x.f)})가 트위터 권장 하한(${fmtHz(tw.low)})보다 낮아요. 트위터에 무리가 가서 왜곡이 늘어요.`);
  if(e.mat<=2)warn('warn','인클로저 재질이 약해서 중저역이 탁하게 울려요.');
  const sysSens=w.sens-(0.3+(5-x.q)*0.2);
  const Pd=Math.min(w.power*1.2,tw.power*4);
  const Pa=a.power;
  const maxSPL=sysSens+10*Math.log10(Math.min(Pa,Pd));
  if(Pa>Pd*2)warn('warn',`앰프 출력(${Pa}W)이 스피커 허용 입력(약 ${Math.round(Pd)}W)의 2배를 넘어요. 볼륨을 높이면 유닛이 망가질 수 있어요.`);
  if(Pa<Pd*0.35)warn('info',`앰프(${Pa}W)가 스피커에 비해 힘이 모자라서 큰 소리에서 일찍 찌그러져요.`);

  const clarity=clamp(((a.q*.4+x.q*.3+e.mat*.3)/5)*100-(strain?15:0),0,100);
  const bass=clamp((130-f3m)/102*100,0,100);
  const balance=clamp(100-9*rms,0,100);
  const head=clamp((maxSPL-80)/32*100,0,100);
  const overall=MODE==='easy'?(.4*balance+.33*bass+.27*head):(.3*balance+.25*bass+.25*clarity+.2*head);   // 초급 모드는 선명도 제외
  Object.assign(s,{ok:true,wf,tf,gT,post,dB,ref,f3:f3m,fhi,sysSens,Pa,Pd,maxSPL,rms,tilt,
    scores:{bass,balance,clarity,head,overall},
    grade:overall>=85?'S':overall>=75?'A':overall>=62?'B':overall>=48?'C':'D'});
  return s;
}

