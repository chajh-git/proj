  for(let i=0;i<NP;i++){
    if(dB[i]>=ref-3){
      if(i>0){const tt=clamp((ref-3-dB[i-1])/(dB[i]-dB[i-1]),0,1);f3m=FREQ[i-1]*Math.pow(FREQ[i]/FREQ[i-1],tt);}
      break;
    }
  }
  let fhi=FREQ[NP-1];
  for(let i=NP-1;i>=0;i--){if(dB[i]>=ref-3){fhi=FREQ[i];break;}}
  const m=band(100,12000);
  let sq=0,n=0,maxDev=-99,maxF=0,minDev=99,minF=0;
  for(let i=0;i<NP;i++){
    if(FREQ[i]>=100&&FREQ[i]<=12000){
      const d=dB[i]-m;sq+=d*d;n++;
      if(FREQ[i]>=150){
        if(d>maxDev){maxDev=d;maxF=FREQ[i];}
        if(d<minDev){minDev=d;minF=FREQ[i];}
      }
    }
  }
  const rms=Math.sqrt(sq/Math.max(1,n));
  const tilt=band(4000,12000)-band(300,2000);

  if(tilt>3)warn('warn',`고음이 중음보다 ${tilt.toFixed(1)}dB 강해서 소리가 날카로워요. 트위터를 낮추는 패드형 크로스오버나 감도가 낮은 트위터가 필요해요.`);
  else if(tilt<-3)warn('warn',`고음이 ${(-tilt).toFixed(1)}dB 약해서 소리가 답답해요. 감도가 높은 트위터를 써보세요.`);
