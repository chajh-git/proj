      ride.played=true;
      let rem=0;
      if(ride.open||!ride.empty)rem=AE.voice(cabAt==='down'?'arrB1':'arr1F').remain;   // 지하 1층이면 1번, 1층이면 2번 음원
      ride.openAt=now+rem*1000;   // 음원이 끝나는 직후 문이 열린다
    }
    if(ride.played&&now>=ride.openAt){
      if(ride.empty){elevTarget=ride.open?1:0;ride=null;return;}   // 빈 승강차: 호출한 층에 도착하면 문을 연다
      ride.phase='opening';elevTarget=1;
    }
  }else if(ride.phase==='opening'){
    if(elevAmt>=.95){ride=null;busy=false;toast(area==='down'?'지하 1층에 도착했어요.':'1층에 도착했어요.');}
  }
}
function resolve(p,boxes){
  const r=.32;
  for(const b of boxes){
    const cx=clamp(p.x,b[0],b[1]),cz=clamp(p.z,b[2],b[3]),dx=p.x-cx,dz=p.z-cz,d2=dx*dx+dz*dz;
    if(d2<r*r){
      if(d2>1e-6){const d=Math.sqrt(d2);p.x=cx+dx/d*r;p.z=cz+dz/d*r;}
      else{
        const l=p.x-b[0],rr=b[1]-p.x,t=p.z-b[2],bt=b[3]-p.z,m=Math.min(l,rr,t,bt);
        if(m===l)p.x=b[0]-r;else if(m===rr)p.x=b[1]+r;else if(m===t)p.z=b[2]-r;else p.z=b[3]+r;
      }
    }
  }
}
const WALK=3.9,RUN=6.76; // 이동 속도 30% 증가 (기존 3.0 / 5.2)
let last=performance.now(),bob=0,lastWhere='';
// 플레이어가 1층 승강차 안에 있는지
// 수동 모드에서 누르고 있을 문: 승강차 안이면 승강차 문, 1층 승강장 문 앞이면 층 문
function manualTarget(){if(inCabNow())return 'cab';if(cabAt==='up'&&area==='up'&&pos.z>-6.6&&pos.z<-2&&Math.abs(pos.x+4.5)<2)return 'land';return null;}
// 구조대: 20초 뒤 바깥에서 들어와 1층 승강장 문을 연 다음 승강차 문을 연다
function updateRescue(){
  if(!rescueSt)return;
  const n=performance.now();
  if(rescueSt.stage==='wait'&&n>=rescueSt.t){
    if(!rescuerG){rescuerG=new THREE.Group();const vest=jm(0xf08a1c,{roughness:.6}),dark=jm(0x2a2e33,{roughness:.8}),skin=jm(0xe2b890,{roughness:.7});
      const body=new THREE.Mesh(new THREE.CylinderGeometry(.22,.24,.9,16),vest);body.position.y=.95;rescuerG.add(body);
      const legs=new THREE.Mesh(new THREE.CylinderGeometry(.2,.2,.8,14),dark);legs.position.y=.4;rescuerG.add(legs);
      const head=new THREE.Mesh(new THREE.SphereGeometry(.14,14,10),skin);head.position.y=1.6;rescuerG.add(head);
      const helm=new THREE.Mesh(new THREE.SphereGeometry(.16,14,8,0,Math.PI*2,0,Math.PI/2),jm(0xf2d200,{roughness:.5}));helm.position.y=1.66;rescuerG.add(helm);
      rescuerG.traverse(o=>{if(o.isMesh)o.castShadow=true;});scene.add(rescuerG);}
    rescuerG.position.set(-4.5,0,-1.2);rescuerG.visible=true;
    rescueSt.stage='walk';rescueSt.t0=n;
  }else if(rescueSt.stage==='walk'){
    const k=Math.min(1,(n-rescueSt.t0)/3000);
    rescuerG.position.set(-4.5,0,-1.2+(-4.3+1.2)*k);
    if(k>=1){rescueSt.stage='landing';rescueSt.t0=n;}
  }else if(rescueSt.stage==='landing'){
    emergManual=true;manLand=Math.min(1,(n-rescueSt.t0)/1500);
    if(manLand>=1){rescueSt.stage='cab';rescueSt.t0=n;}
  }else if(rescueSt.stage==='cab'){
    manCab=Math.min(1,(n-rescueSt.t0)/1500);
    if(manCab>=1){rescueSt.stage='done';if(rescuerG)rescuerG.visible=false;toast('구조 완료! 승강차 문이 열렸어요.');}
  }
}
function inCabNow(){return pos.z<-6.1&&pos.x>-5.4&&pos.x<-3.6&&cabAt===area;}
// 화면 갱신 보호: 한 프레임에서 오류가 나도 화면은 계속 그려지고, 오류 내용을 한 번 알려준다
function dbgErr(e){if(!dbgErr.shown){dbgErr.shown=true;try{toast('오류: '+((e&&e.message)||e),true);}catch(x){}}try{console.error(e);}catch(x){}}
function tick(now){
  requestAnimationFrame(tick);
  try{tickInner(now);}catch(e){
    dbgErr(e);
    try{camera.position.set(pos.x,AREA_Y[area]+1.65,pos.z);camera.rotation.set(pitch,yaw,0);renderer.render(scene,camera);}catch(x){}
  }
}
function tickInner(now){
  if(!renderer)return;
  const dt=Math.min(.05,(now-last)/1000);last=now;
  updateSubway(dt,now);
  updateGuide(dt,now);
  if(started&&!cur&&(!busy||ride||subRide)){
    let f=(keys.KeyW||keys.ArrowUp?1:0)-(keys.KeyS||keys.ArrowDown?1:0)-joy.y;
    let r=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0)+joy.x;
    const mag=Math.min(1,Math.hypot(f,r));
    if(mag>.01){
      const len=Math.hypot(f,r),run=keys.ShiftLeft||keys.ShiftRight||runOn,sp=(run?RUN:WALK)*dt*mag/len;
      pos.x+=(-Math.sin(yaw)*f+Math.cos(yaw)*r)*sp;pos.z+=(-Math.cos(yaw)*f-Math.sin(yaw)*r)*sp;
      if(subMoving()){resolve(pos,trainBoxes());pos.x=clamp(pos.x,trainX-18.6,trainX+18.6);pos.z=clamp(pos.z,-20.7,-18.2);}else{resolve(pos,area==='up'?(pos.z<-12.5?subBoxesNow():boxesUp):boxesDown);if((emergManual&&area==='up'?manLand:elevAmt)<.85)resolve(pos,area==='down'?DOORBOX_B:DOORBOX);}bob+=dt*8;
    }
    near=null;let nd=1.7;
    for(const s of stations){if(s.area!==area||(s.cond&&!s.cond()))continue;const d=s.id==='subGo'?0:Math.hypot(pos.x-s.x,pos.z-s.z);if(d<nd){nd=d;near=s;}}
    for(const f of FLY){if(!f.rest||f.area!==area||!f.cand)continue;const d=Math.hypot(pos.x-f.p[0],pos.z-f.p[2]);if(d<nd){nd=d;near=f.cand;}}
    for(const d of DROPPED){if(d.area!==area)continue;const dd=Math.hypot(pos.x-d.x,pos.z-d.z);if(dd<nd){nd=dd;near=d.cand;}}
    aimBtn=aimAtButton(0,0,2.4);
    const pr=$('#prompt'),ta=$('#tAct'),lbl=aimBtn?aimBtn.tip:(near?near.label:'');
    if(lbl){pr.style.display='block';pr.innerHTML=`<b>${touchOn?'누르기':'E'}</b>${lbl}`;ta.style.display='flex';ta.textContent=aimBtn?'누르기':'열기';}
    else{pr.style.display='none';ta.style.display='none';}
  }else{$('#prompt').style.display='none';$('#tAct').style.display='none';aimBtn=null;}
  const w=area==='down'?'지하 1층':(subMoving()?'열차 안':(gy<-1.2?(pos.x>400?'하이파이역':'사운드웍스역'):(pos.x>400?'하이파이역 출구':(pos.x>8.3?'거리':'1층 공방'))));
  if(w!==lastWhere){lastWhere=w;$('#where').textContent=w;}
  updateFlyers(dt);
  $('#tThrow').style.display=(touchOn&&started&&!cur&&invShown[invSel]&&invShown[invSel].drop&&invShown[invSel].drop.id===JUNK.id)?'flex':'none';
  updateElevator(dt,now);updateBtnLit(now);
  const moving=ride&&!ride.empty&&ride.phase==='moving';
  // 승강로 기계 장치: 승강차가 운행 중일 때만 돈다
  if(ride&&ride.phase==='moving')for(const mp of machSpin)mp.obj.rotation[mp.axis||'z']+=mp.speed*dt;
  if(moving)setLightMix(clamp(-cabG.position.y/6,0,1));
  const baseY=(moving||(faultSt&&inCabNow()))?cabG.position.y:(area==='up'?gy:AREA_Y[area]);   // 승강차 안에 있으면 승강차 높이를 따라가 멈춘 순간 위로 튀지 않는다
  const shake=moving?Math.sin(now/37)*.004+Math.sin(now/91)*.003:(subMoving()?Math.sin(now/29)*.006+Math.sin(now/71)*.004:0);
  camera.position.set(pos.x+(moving?Math.sin(now/53)*.002:0),baseY+1.65+Math.sin(bob)*.015+shake,pos.z);
  camera.rotation.set(pitch,yaw,0);
  const pulse=.5+.25*Math.sin(now/380);
  markers.forEach(m=>{m.material.opacity=pulse;m.visible=m.userData.area===area&&(!m.userData.s.cond||m.userData.s.cond());});
  renderer.render(scene,camera);
  if(cur&&(cur==='bench'||cur==='counter'||cur==='showcase'))drawScope();
}
requestAnimationFrame(tick);

updateHud();setCustomerLook();refreshPeds();refreshShowcase();setBench();applyArea();
})();
