  const st=ob.x!==undefined?{x:ob.x,z:ob.z}:stations.find(q=>q.id===(ob.id==='hi'?'shopD':ob.id)&&q.area==='up');
  if(!st){guide.pts=null;return;}
  const P={x:pos.x,z:pos.z,ug:gy<-.8,reg:area==='down'?'D':(pos.x>400?'B':'A')},T={x:st.x,z:st.z,reg:ob.reg||(st.x>400?'B':'A')};
  const r=guideRoute(P,T,inTrainNow());
  if(tutDone&&!(P.ug||P.reg!==T.reg||inTrainNow())){guide.pts=null;setCoach('');return;}   // 지하철역으로 가야 할 때만 안내
  let msg=r.msg||ob.msg;
  if(!P.ug&&P.reg===T.reg&&Math.hypot(pos.x-T.x,pos.z-T.z)<3.2)msg=ACT[ob.id]?ACT[ob.id]():ob.msg;
  setCoach(msg);
  guide.pts=r.pts;guide.seg=[];guide.total=0;
  if(r.pts&&r.pts.length>1){
    let tot=0;
    for(let i=0;i<r.pts.length-1;i++){const a=r.pts[i],b=r.pts[i+1],l=Math.hypot(b[0]-a[0],b[1]-a[1]);if(l<.01)continue;guide.seg.push({a,b,l,c:tot});tot+=l;}
    guide.total=tot;
  }
}
function drawGuide(now){
  ensureGuideMeshes();
