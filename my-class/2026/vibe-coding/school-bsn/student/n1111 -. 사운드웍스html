  }
  if(sel[cat]!==id&&avail(id)<=0){toast('남은 부품이 없어요.',true);return false;}
  sel[cat]=id;
  if(cat==='e'&&sel.w&&BY[sel.w].size>p.maxDriver){sel.w='';toast('우퍼가 새 인클로저에 맞지 않아서 트레이로 돌아갔어요.');}
