function subSeekMs(x){   // 출발 후 이동 거리가 x(m)가 되는 시간(ms)
  let lo=0,hi=subCalc(0).T;for(let i=0;i<60;i++){const m=(lo+hi)/2;if(subCalc(m).s<x)lo=m;else hi=m;}return lo*1000;
}
function subCalc(t){ // 출발 t초 후의 이동 거리 s(m)와 속도 v(m/s): 가속 -> 70km/h 순항 -> 감속
  const a=SUB.acc,v=SUB.vmax,ta=v/a,da=v*v/(2*a),cr=SUB.dist-2*da,tc=cr/v,T=2*ta+tc;
  if(t<=0)return {s:0,v:0,T};
  if(t<ta)return {s:.5*a*t*t,v:a*t,T};
  if(t<ta+tc)return {s:da+v*(t-ta),v,T};
  const tt=Math.min(t-ta-tc,ta);
  return {s:da+cr+v*tt-.5*a*tt*tt,v:Math.max(0,v-a*tt),T};
}
const subMoving=()=>trn.phase==='moving'&&trn.rider;   // 플레이어가 달리는 열차에 타고 있는 동안
function trainVol(d){ if(d<=100)return 1-.5*d/100; if(d<170)return .5*(170-d)/70; return 0; }
const inTrainNow=()=>{const zo=TRK(trainX);return pos.z<-18.1+zo&&pos.z>-20.8+zo&&Math.abs(pos.x-trainX)<18.7;};
function groundYAt(x,z){ // 계단과 승강장의 높이
  if(area!=='up')return 0;
  if(subMoving())return SUB.platY;
  if(z<-12.5&&((x>=6&&x<=46)||(x>=806&&x<=846)))return SUB.platY;
  for(const st of SUB.stairs){if(x>=st[0]-.3&&x<=st[1]+.3&&z>=-12.5&&z<=-6.0)return SUB.platY*clamp((-6.0-z)/6.5,0,1);}
  return 0;
}
function trainBoxesRaw(){ // 열차 차체: 남쪽 벽(문 구멍), 북쪽 벽, 끝벽(연결통로 구멍), 연결통로 벽
  const tx=trainX,L=[],OX=[-12.5,0,12.5];
  OX.forEach((ox,i)=>{
    const c=tx+ox;
    L.push([c-6,c-3.78,-18.1,-18.0],[c-2.22,c+2.22,-18.1,-18.0],[c+3.78,c+6,-18.1,-18.0],[c-6,c+6,-20.95,-20.85]);
    if(i===0)L.push([c-6.1,c-6,-20.95,-18.0]);else L.push([c-6.1,c-6,-20.95,-20.1],[c-6.1,c-6,-18.8,-18.0]);
    if(i===2)L.push([c+6,c+6.1,-20.95,-18.0]);else L.push([c+6,c+6.1,-20.95,-20.1],[c+6,c+6.1,-18.8,-18.0]);
