  const cone=new THREE.Mesh(new THREE.CylinderGeometry(R*.87,R*.32,dep,40,1,true),paper);cone.rotation.x=Math.PI/2;cone.position.z=-dep/2+R*.02;cone.castShadow=true;inner.add(cone);
