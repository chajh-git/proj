function guideRoute(P,T,inTrain){
  const sx=stairX(P.reg);
  if(inTrain){
    if(trn.phase==='dwell'&&trainAt===T.reg){
      const g=doorGaps();let best=g[0];for(const x of g)if(Math.abs(x-pos.x)<Math.abs(best-pos.x))best=x;
      const tx=stairX(T.reg);
      return {pts:[[pos.x,pos.z],[best,-18.8],[best,-16.9],[best,-13.4],[tx,-13.4],[tx,-12.0],[tx,-6.0]].concat(findPath(T.reg,tx,-5.8,T.x,T.z).slice(1)),msg:'도착했어요! 열차 문으로 내려 계단으로 올라가세요'};
    }
    return {pts:null,msg:'열차 안에서 기다려요. '+(T.reg==='B'?'하이파이역':'사운드웍스역')+'에 도착하면 내려요'};
  }
  if(P.reg===T.reg){
    if(!P.ug)return {pts:findPath(P.reg,P.x,P.z,T.x,T.z)};
    return {pts:[[P.x,P.z],[P.x,-13.4],[sx,-13.4],[sx,-12.0],[sx,-6.0]].concat(findPath(P.reg,sx,-5.8,T.x,T.z).slice(1))};
  }
  let pts;
  if(!P.ug)pts=findPath(P.reg,P.x,P.z,sx,-5.8).concat([[sx,-6.0],[sx,-12.2],[sx,-13.4]]);
  else pts=[[P.x,P.z]];
  const last=pts[pts.length-1],xc=stationX(P.reg);
  const here=trainAt===P.reg&&Math.abs(trainX-xc)<1&&trn.phase==='dwell'&&psdDoor>.3;
  if(here){
    const g=doorGaps();let best=g[0];for(const x of g)if(Math.abs(x-last[0])<Math.abs(best-last[0]))best=x;
    return {pts:pts.concat([[best,-16.9],[best,-18.8]]),msg:'열차 문으로 들어가세요'};
  }
  return {pts:pts.concat([[xc,-16.2]]),msg:'승강장에서 열차를 기다리세요. 열차가 서면 문으로 타요'};
}
