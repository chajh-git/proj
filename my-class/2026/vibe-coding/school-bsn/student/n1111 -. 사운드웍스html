const FS=48000;
function coef(f){
  const ff=Math.min(f.f,21000);
  const w0=2*Math.PI*ff/FS,c=Math.cos(w0),s=Math.sin(w0);
  let b0,b1,b2,a0,a1,a2;
  if(f.t==='lp'||f.t==='hp'||f.t==='pk'){
    const al=s/(2*f.q);
    if(f.t==='lp'){b0=(1-c)/2;b1=1-c;b2=b0;a0=1+al;a1=-2*c;a2=1-al;}
    else if(f.t==='hp'){b0=(1+c)/2;b1=-(1+c);b2=b0;a0=1+al;a1=-2*c;a2=1-al;}
    else{const A=Math.pow(10,f.g/40);b0=1+al*A;b1=-2*c;b2=1-al*A;a0=1+al/A;a1=-2*c;a2=1-al/A;}
  }else{
    const A=Math.pow(10,f.g/40),al=s/2*Math.SQRT2,sq=2*Math.sqrt(A)*al;
    if(f.t==='ls'){
      b0=A*((A+1)-(A-1)*c+sq);b1=2*A*((A-1)-(A+1)*c);b2=A*((A+1)-(A-1)*c-sq);
      a0=(A+1)+(A-1)*c+sq;a1=-2*((A-1)+(A+1)*c);a2=(A+1)+(A-1)*c-sq;
    }else{
      b0=A*((A+1)+(A-1)*c+sq);b1=-2*A*((A-1)+(A+1)*c);b2=A*((A+1)+(A-1)*c-sq);
      a0=(A+1)-(A-1)*c+sq;a1=2*((A-1)-(A+1)*c);a2=(A+1)-(A-1)*c-sq;
    }
  }
  return [b0/a0,b1/a0,b2/a0,a1/a0,a2/a0];
}
function resp(cf,w){
  const c1=Math.cos(w),s1=Math.sin(w),c2=Math.cos(2*w),s2=Math.sin(2*w);
  const nr=cf[0]+cf[1]*c1+cf[2]*c2,ni=-(cf[1]*s1+cf[2]*s2);
  const dr=1+cf[3]*c1+cf[4]*c2,di=-(cf[3]*s1+cf[4]*s2);
  const d=dr*dr+di*di;
  return [(nr*dr+ni*di)/d,(ni*dr-nr*di)/d];
}
const NP=140;
const FREQ=Array.from({length:NP},(_,i)=>20*Math.pow(1000,i/(NP-1)));
const WW=FREQ.map(f=>2*Math.PI*f/FS);
function pathResp(cfs){
  const re=new Float64Array(NP),im=new Float64Array(NP);
  for(let i=0;i<NP;i++){
    let r=1,m=0;
    for(const cf of cfs){const q=resp(cf,WW[i]);const nr=r*q[0]-m*q[1];m=r*q[1]+m*q[0];r=nr;}
    re[i]=r;im[i]=m;
  }
  return [re,im];
}

function computeSpec(c){
  const s={ok:false,warns:[],cfg:c};
  const miss=['w','t','e','x','a'].filter(k=>!c[k]);
  if(miss.length){s.error='부품 5종(우퍼, 트위터, 인클로저, 크로스오버, 앰프)을 모두 놓으면 성능이 계산돼요.';s.missing=miss;return s;}
  const w=c.w,tw=c.t,e=c.e,x=c.x,a=c.a;
  s.cost=w.price+tw.price+e.price+x.price+a.price;
  if(w.size>e.maxDriver){s.error=`이 인클로저에는 ${w.size}" 우퍼가 들어가지 않아요. (최대 ${e.maxDriver}")`;return s;}
  const warn=(lv,t)=>s.warns.push({lv,t});
  const wf=[],tf=[],post=[];

  if(e.type==='sealed'){
    const k=Math.sqrt(1+w.vas/e.vol),qtc=w.qts*k,fc=w.fs*k;
    wf.push({t:'hp',f:fc,q:qtc});
    s.qtc=qtc;
    if(qtc>0.9)warn('warn',`밀폐 박스에 비해 우퍼가 너무 커서(Qtc ${qtc.toFixed(2)}) 저음이 붕 뜨고 느리게 울려요. 박스가 더 크면 좋아요.`);
    else if(qtc<0.5)warn('warn',`Qtc ${qtc.toFixed(2)}로 저음이 얇고 힘이 없어요. 더 작은 박스나 다른 우퍼가 어울려요.`);
  }else{
    const vi=15*Math.pow(w.qts,3.3)*w.vas,fi=.42*Math.pow(w.qts,-.96)*w.fs;
    const rV=e.vol/vi,rF=e.fb/fi;
    let f3=e.fb*(0.95+0.25*Math.max(0,-Math.log(rV)));
    f3=Math.max(f3,0.75*w.fs*(0.8+0.4*w.qts));
    wf.push({t:'hp',f:f3,q:0.5412},{t:'hp',f:f3,q:1.3066});
    const bump=Math.min(7,2*Math.max(0,Math.log(rV))+3*Math.max(0,Math.log(rF)));
    const dip=Math.min(7,4*Math.max(0,-Math.log(rF)));
    if(bump>0.5)post.push({t:'pk',f:e.fb*1.5,q:1.2,g:bump});
    if(dip>0.5)post.push({t:'pk',f:e.fb*1.6,q:1.5,g:-dip});
    if(bump>2)warn('warn','인클로저 용량이나 포트 튜닝이 이 우퍼와 맞지 않아서 저음 부근이 부풀어요.');
    if(dip>2)warn('warn','포트 튜닝이 우퍼에 비해 너무 낮아서 중저음이 빠져요.');
    if(rV<0.55)warn('warn','박스가 우퍼에 비해 작아서 저음이 높은 쪽에서 끊겨요.');
    if(w.fs*0.75*(0.8+0.4*w.qts)>e.fb*1.05)warn('info','우퍼 자체의 한계 때문에 박스가 허용하는 만큼 저음이 내려가지 못해요.');
  }
  wf.push({t:'lp',f:w.upper*1.35,q:.7071});
  if(w.breakup)wf.push({t:'pk',f:w.breakup.f,q:w.breakup.q,g:w.breakup.g});
  for(let i=0;i<(x.slope===24?2:1);i++)wf.push({t:'lp',f:x.f,q:.7071});
  for(let i=0;i<(x.slope===24?2:1);i++)tf.push({t:'hp',f:x.f,q:.7071});
  tf.push({t:'hp',f:tw.low*.65,q:.7071});
  tf.push({t:'lp',f:tw.high,q:.7071});
  if(tw.peak)tf.push({t:'pk',f:tw.peak.f,q:tw.peak.q,g:tw.peak.g});
  const pol=x.slope===12?-1:1;
  const gT=pol*Math.pow(10,(tw.sens-w.sens-x.att)/20);
  const cabG=(5-e.mat)*0.9;
  if(cabG>0.1)post.push({t:'pk',f:520/Math.cbrt(e.vol/10),q:4,g:cabG});
  if(a.warm)post.push({t:'ls',f:180,g:a.warm});
  if(a.roll)post.push({t:'hs',f:7000,g:-a.roll});

  const wr=pathResp(wf.map(coef)),tr=pathResp(tf.map(coef)),pc=post.map(coef);
  const dB=new Array(NP);
  for(let i=0;i<NP;i++){
    const hr=wr[0][i]+gT*tr[0][i],hi=wr[1][i]+gT*tr[1][i];
    let mag=Math.hypot(hr,hi);
    for(const cf of pc){const q=resp(cf,WW[i]);mag*=Math.hypot(q[0],q[1]);}
    dB[i]=20*Math.log10(Math.max(mag,1e-6));
  }
  const band=(f1,f2)=>{let sm=0,n=0;for(let i=0;i<NP;i++)if(FREQ[i]>=f1&&FREQ[i]<=f2){sm+=dB[i];n++;}return sm/Math.max(1,n);};
  const ref=band(200,2000);
