  if(!guide.pts||!seg.length){hideGuide();return;}
  const N=guide.arrows.length,sp=1.4,ph=((now/1000)*1.3)%sp;
  let k=0,si=0;
  for(let d=ph;d<guide.total&&k<N;d+=sp){
    while(si<seg.length-1&&d>seg[si].c+seg[si].l)si++;
    const q=seg[si],t=(d-q.c)/q.l,x=q.a[0]+(q.b[0]-q.a[0])*t,z=q.a[1]+(q.b[1]-q.a[1])*t,m=guide.arrows[k++];
    m.visible=true;m.position.set(x,(area==='down'?-6:groundYAt(x,z))+.04,z);m.rotation.y=Math.atan2(-(q.b[1]-q.a[1]),q.b[0]-q.a[0]);
  }
  for(;k<N;k++)guide.arrows[k].visible=false;
  const last=seg[seg.length-1],bx=last.b[0],bz=last.b[1];
