function josa(word,a,b){ // 받침이 있으면 a, 없으면 b를 붙인다 (을/를)
  const ch=word.trim().slice(-1),c=ch.charCodeAt(0);
  let batchim=false;
  if(c>=0xAC00&&c<=0xD7A3)batchim=(c-0xAC00)%28!==0;
  else if(ch&&'LlNnMmRr'.includes(ch))batchim=true;   // 엘, 엔, 엠, 알
  else if(ch&&'013678'.includes(ch))batchim=true;      // 영, 일, 삼, 육, 칠, 팔
  return word+(batchim?a:b);
}
