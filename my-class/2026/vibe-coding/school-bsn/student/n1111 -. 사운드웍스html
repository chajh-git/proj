function disposeGroup(g){
  g.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material)(Array.isArray(o.material)?o.material:[o.material]).forEach(m=>m.dispose());});
  while(g.children.length)g.remove(g.children[0]);
}
function setBench(){
  if(!window.__buildSpeaker||!benchGroup)return;
  disposeGroup(benchGroup);
  const c=cfgOf(sel);
  if(c.e)benchGroup.add(window.__buildSpeaker(c,true));
}
function refreshPeds(){
  if(!window.__buildSpeaker)return;
  pedGroups.forEach((pg,i)=>{
    disposeGroup(pg);
    const it=stock[i];
    if(it)pg.add(window.__buildSpeaker(cfgOf(it.ids),true));
  });
}
