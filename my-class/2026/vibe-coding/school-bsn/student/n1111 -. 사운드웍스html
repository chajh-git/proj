  const ring=new THREE.Mesh(new THREE.TorusGeometry(mR,R*.025,6,28),chrome);ring.rotation.x=Math.PI/2;ring.position.z=-dep-R*.12-mL;inner.add(ring);
  // 단자 두 개
  [[-R*.55,R*.6],[-R*.45,R*.72]].forEach(q=>{const t=new THREE.Mesh(new THREE.BoxGeometry(R*.18,R*.12,R*.06),tabM);t.position.set(q[0],q[1],R*.03);inner.add(t);});
