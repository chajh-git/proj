// ===== 싸구려 유닛 던지기와 조각 =====
const jm=(c,o)=>new THREE.MeshStandardMaterial(Object.assign({color:c,roughness:.65,metalness:.05},o||{}));
// 유닛 모양 만들기: parts에 frame(프레임, 진동판, 단자)과 magnet(자석)을 넣는다. 자석이 같이 있으면 프레임 중심 뒤쪽에 붙는다
function junkBuild(parts){
  const g=new THREE.Group();
  if(parts.includes('frame')){
    const paper=jm(0xf7f7f4,{side:THREE.DoubleSide,roughness:.85}),rubber=jm(0xe8e8e2,{roughness:.9}),chrome=jm(0xd9dde0,{metalness:.9,roughness:.15}),steel=jm(0x1a1c1e,{metalness:.5,roughness:.55}),tabM=jm(0xb9a77a,{metalness:.7,roughness:.4});
    const cone=new THREE.Mesh(new THREE.CylinderGeometry(.27,.1,.1,32,1,true),paper);cone.rotation.x=Math.PI/2;cone.position.z=-.05;g.add(cone);
    const sur=new THREE.Mesh(new THREE.TorusGeometry(.265,.022,8,36),rubber);sur.position.z=.004;g.add(sur);
    const cap=new THREE.Mesh(new THREE.SphereGeometry(.075,20,10,0,Math.PI*2,0,Math.PI/2),chrome);cap.rotation.x=Math.PI/2;cap.position.z=-.08;g.add(cap);
    const neck=new THREE.Mesh(new THREE.CylinderGeometry(.06,.06,.04,18),steel);neck.rotation.x=Math.PI/2;neck.position.z=-.12;g.add(neck);
    [[-.187,.187],[-.23,.13]].forEach(q=>{const t=new THREE.Mesh(new THREE.BoxGeometry(.05,.035,.03),tabM);t.position.set(q[0],q[1],0);g.add(t);});
  }
  if(parts.includes('magnet')){
    const mag=new THREE.Mesh(new THREE.CylinderGeometry(.075,.075,.1,20),jm(0x6b5a46,{metalness:.5,roughness:.6}));
    mag.rotation.x=Math.PI/2;mag.position.z=parts.includes('frame')?-.18:0;g.add(mag);
  }
  g.traverse(o=>{if(o.isMesh)o.castShadow=true;});
  return g;
}
function spawnFlyer(kind,parts,pos,rot,vel,wv,area,r){
  const g=junkBuild(parts);g.position.set(pos[0],pos[1],pos[2]);g.rotation.set(rot.x,rot.y,rot.z);scene.add(g);
  const f={g,p:pos.slice(),v:vel.slice(),w:wv.slice(),kind,area,r,rest:false,still:0,cand:null};
  if(kind!=='whole')f.cand={id:'pickPiece',label:(kind==='frame'?'프레임 및 진동판':'자석')+' 줍기',x:pos[0],z:pos[2],area,piece:f};
  FLY.push(f);return f;
}
function flyObstacles(f){
  if(f.area==='down')return boxesDown;
  if(f.area==='up'&&inTrainArea(f.p[0],f.p[2]))return trainBoxes();
  if(f.p[2]<-12.5&&((f.p[0]>=0&&f.p[0]<=50)||(f.p[0]>=790&&f.p[0]<=850)))return subBoxesNow();
  return boxesUp;
}
function inTrainArea(x,z){const zo=TRK(trainX);return z<-18.1+zo&&z>-20.8+zo&&Math.abs(x-trainX)<18.2;}
function flyFloor(f){if(f.area==='up'&&inTrainArea(f.p[0],f.p[2]))return -4.5;return f.area==='down'?-6:groundYAt(f.p[0],f.p[2]);}
function flyCeil(f){
  if(f.area==='down')return -2.6;
  const x=f.p[0],z=f.p[2];
  if(z<-12.5&&((x>=6&&x<=46)||(x>=806&&x<=846)))return -.3;
  if(x<8.3&&z>-6.1&&z<6.1)return 3.4;
  return 1e9;
}
// 부딪힌 유닛은 프레임 및 진동판과 자석으로 나뉜다
function splitFlyer(f){
  f.g.updateMatrixWorld(true);
  const mp=new THREE.Vector3(0,0,-.18).applyMatrix4(f.g.matrixWorld);
  const rot={x:f.g.rotation.x,y:f.g.rotation.y,z:f.g.rotation.z};
  scene.remove(f.g);FLY.splice(FLY.indexOf(f),1);
  const rv=()=>Math.random()*2-1,vx=f.v[0],vy=f.v[1],vz=f.v[2];
  spawnFlyer('frame',['frame'],f.p.slice(),rot,[vx*.4+rv()*1.2,Math.max(0,vy)*.3+rv()*.8,vz*.4+rv()*1.2],[rv()*9,rv()*9,rv()*9],f.area,.31);
  spawnFlyer('magnet',['magnet'],[mp.x,mp.y,mp.z],rot,[vx*.6+rv()*2,vy*.6+1+Math.random()*1.5,vz*.6+rv()*2],[rv()*16,rv()*16,rv()*16],f.area,.08);
  toast('유닛이 부서져 프레임과 자석이 분리됐어요.');
}
function updateFlyers(dt){
  const FG=-9.8;
  for(const d of DROPPED)if(d.mesh)d.mesh.visible=d.area===area;
  for(const f of FLY.slice()){
    if(f.area!==area||f.rest)continue;
    f.v[1]+=FG*dt;
    f.p[0]+=f.v[0]*dt;f.p[1]+=f.v[1]*dt;f.p[2]+=f.v[2]*dt;
    let hit=false;const r=f.r;
    for(const b of flyObstacles(f)){
      const x=f.p[0],z=f.p[2];
      if(x>b[0]-r&&x<b[1]+r&&z>b[2]-r&&z<b[3]+r){
        const dl=x-(b[0]-r),dr=(b[1]+r)-x,dn=z-(b[2]-r),df=(b[3]+r)-z,m=Math.min(dl,dr,dn,df);
        if(m===dl){f.p[0]=b[0]-r;f.v[0]=-Math.abs(f.v[0])*.45;}
        else if(m===dr){f.p[0]=b[1]+r;f.v[0]=Math.abs(f.v[0])*.45;}
        else if(m===dn){f.p[2]=b[2]-r;f.v[2]=-Math.abs(f.v[2])*.45;}
        else{f.p[2]=b[3]+r;f.v[2]=Math.abs(f.v[2])*.45;}
        hit=true;
      }
    }
    const fl=flyFloor(f)+r;
    if(f.p[1]<fl){
      f.p[1]=fl;if(f.v[1]<0)f.v[1]=-f.v[1]*.35;
      const k=Math.exp(-6*dt);f.v[0]*=k;f.v[2]*=k;hit=true;
    }
    const ce=flyCeil(f)-r;
    if(f.p[1]>ce){f.p[1]=ce;if(f.v[1]>0)f.v[1]=-f.v[1]*.35;hit=true;}
    const damp=Math.exp(-(hit?3:.4)*dt);
    f.w[0]*=damp;f.w[1]*=damp;f.w[2]*=damp;
    f.g.rotation.x+=f.w[0]*dt;f.g.rotation.y+=f.w[1]*dt;f.g.rotation.z+=f.w[2]*dt;
    f.g.position.set(f.p[0],f.p[1],f.p[2]);
    if(f.kind==='whole'&&hit){splitFlyer(f);continue;}
    const onFloor=Math.abs(f.p[1]-fl)<.01,sp=Math.hypot(f.v[0],f.v[1],f.v[2]),wsp=Math.hypot(f.w[0],f.w[1],f.w[2]);
    if(onFloor&&sp<.25&&wsp<.6){f.still+=dt;if(f.still>.6){f.rest=true;f.v=[0,0,0];f.w=[0,0,0];if(inTrainArea(f.p[0],f.p[2])){f.onTrain=true;f.rel=f.p[0]-trainX;}}}else f.still=0;
    if(f.cand){f.cand.x=f.p[0];f.cand.z=f.p[2];}
  }
}
